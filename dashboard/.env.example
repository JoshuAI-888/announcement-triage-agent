# Copy to .env.local for local testing against a real GitHub repo. Leave
# GITHUB_TOKEN / GITHUB_REPO unset (or blank) to run in LOCAL DEV MODE, which
# reads the repo's local files and mocks every GitHub write / workflow
# dispatch (see README.md).

# --- GitHub integration (leave blank for local dev mode) -------------------
# Fine-grained PAT scoped to `contents: write` + `actions: write` on this repo
# only (DEPLOY.md §2). Required in production for POST /api/config,
# POST /api/portal-password, POST /api/run-now, POST /api/run-eval.
GITHUB_TOKEN=
# "owner/repo", e.g. "joshuafang/announcement-triage-agent"
GITHUB_REPO=
# Defaults to "main" if unset.
GITHUB_BRANCH=main

# --- Portal session signing --------------------------------------------------
# HMAC secret for the signed session cookie (CONTRACTS.md §8). Set this to a
# long random value in any real deployment; a dev fallback is used (and
# logged loudly) if it's unset, which is fine for local testing only.
PORTAL_SESSION_SECRET=
