.env
.venv/
state.db
data/raw/
__pycache__/
*.pyc
.DS_Store

# Generated outputs are ignored by default...
out/*
out/briefs/*
# ...except the small text artifacts the dashboard reads (committed to main via [skip ci]):
!out/run_log.jsonl
!out/pdf_log.jsonl
!out/filings/
!out/filings/*.json
!out/ocr/
!out/ocr/*.txt
!out/briefs/
!out/briefs/*.email.html
!out/briefs/assets/
!out/briefs/assets/*.png
# Bulky/local-only generated things stay ignored:
out/eval_runs/
out/dashboard/
out/gold_drafts.json

# Node / Vercel app
dashboard/node_modules/
dashboard/.vercel/
dashboard/.next/

# Runtime logs (Codex/tooling cruft)
*.log

# Local Claude Code tooling state (settings, agent worktrees)
.claude/
